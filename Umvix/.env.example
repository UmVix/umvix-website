# Anthropic API key — required for the AI chatbot, project estimator,
# and case study generator. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model used for all AI features.
# Defaults to "claude-sonnet-4-6".
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Preferred provider for the chat widget only: when set, the chatbot uses
# Gemini. Get one at https://aistudio.google.com/
# GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-flash-latest

# Optional fallback for the chat widget only: used when no Gemini/Anthropic
# key is set. Get one at https://platform.openai.com/
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# Contact form email — required for Let's Connect + Send Us a Message.
# Get a free API key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Your inbox where contact submissions should arrive.
CONTACT_TO_EMAIL=you@yourdomain.com

# Optional sender address (must be verified in Resend).
# For testing you can leave this blank to use onboarding@resend.dev
# CONTACT_FROM_EMAIL=Umvix Contact <contact@yourdomain.com>
