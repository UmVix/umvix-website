# ── Supabase ──────────────────────────────────────────────────────────────
# Project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address embedded in push messages (mailto: or https:)
VAPID_SUBJECT=mailto:tafoor@start-wise.io

# ── Cron protection ──────────────────────────────────────────────────────
# Any long random string. Vercel sends it as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# ── App ──────────────────────────────────────────────────────────────────
# Public origin of the deployed app (used in invite emails / links)
NEXT_PUBLIC_APP_URL=http://localhost:3001
